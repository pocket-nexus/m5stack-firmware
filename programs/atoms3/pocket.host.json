  "panel": {
    "primary": [128, 128]
  },
  "capabilities": ["input.buttons", "text.glyphs.baked"],
  "bytecode": {
    "engine": "esp-idf-quickjs-ng-0.14.0",
    "source": "drop"
  }
}
