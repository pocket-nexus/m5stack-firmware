#!/bin/sh
# Runs the Pocket CLI of the pinned third_party/pocketjs checkout with Bun.
# ESP-IDF builds use it as POCKETJS_CLI (m5_pocket_app/components.cmake sets
# that default). Bun is taken from PATH, then from ~/.bun/bin.
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
bun=$(command -v bun || true)
if [ -z "$bun" ] && [ -x "$HOME/.bun/bin/bun" ]; then
  bun="$HOME/.bun/bin/bun"
fi
if [ -z "$bun" ]; then
  echo "tools/pocket: bun not found on PATH or in ~/.bun/bin" >&2
  exit 127
fi
exec "$bun" "$root/third_party/pocketjs/tools/pocket.ts" "$@"
