CONFIG_IDF_TARGET="esp32p4"
# The Stamp-P4X carries an ESP32-P4 of revision 3.x (ESP32-P4NRW32X); the
# factory firmware accepts revision 3.0 and later.
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_M5_POCKET_APP_MODE_JS=y
# apps/corep4x-factory/device.ts publishes about 90 values; the SD
# listing is the longest text.
CONFIG_M5_POCKET_BRIDGE_SLOTS=128
CONFIG_M5_POCKET_BRIDGE_EVENTS=32
CONFIG_M5_POCKET_BRIDGE_TEXT_MAX=4096
