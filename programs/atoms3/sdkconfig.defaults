# M5Stack AtomS3: ESP32-S3FN8, 8 MB flash, no PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# The USB-C port is the ESP32-S3 USB Serial/JTAG peripheral.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# No PSRAM on the ESP32-S3FN8.
# CONFIG_SPIRAM is not set

# Application host: AOT only. The QuickJS guest with this application's
# bytecode does not fit in the internal RAM (README.md, memory budget).
# The app task stack is internal RAM.
CONFIG_M5_POCKET_APP_MODE_AOT=y
CONFIG_M5_POCKET_APP_TASK_STACK=40960

# Wi-Fi (factory Wi-Fi scan only): keep its code in flash and its buffers
# small, internal RAM is the limit on this board.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
