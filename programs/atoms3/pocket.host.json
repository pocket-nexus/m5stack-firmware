{
  "$schema": "https://pocketjs.dev/schema/pocket-host-2.json",
  "format": "pocket-host/2",
  "id": "m5stack-atoms3",
  "platform": "esp-idf",
  "form": "takeover",
  "cadences": [30],
  "display": {
    "logicalViewports": [[128, 128]],
    "presentations": ["native"],
    "rasterDensity": 1,
    "animation": "repaint"
